  "symbols": {
    "def.functional": {
      "desc": "Definition of 'Functional' / 'Non-Functional'. Frontend single source: DEFS.euFunctional / DEFS.euNonFunctional. Code.gs aggregates use the literal 'Functional Installed'.",
      "files": ["Code.gs", "index.html"], "reDerive": true,
      "patterns": ["Functional Installed", "DEFS.euFunctional", "DEFS.euNonFunctional"],
      "feeds": ["tab.eu_monthly", "tab.eu_timeline", "tab.ona_monthly", "tab.ona_timeline"],
      "affects": ["eu.kpis", "ona.kpis", "eu.timeline", "eu.intel", "comp.eufc"]
    },
    "def.not_running": {
      "desc": "Two distinct 'not running' defs, now named in DEFS: notRunningByPurity (purity 0 -> nr -> EU 'Purity=0' KPI) vs notRunningByHours (run-hours 0 -> EU Intelligence).",
      "files": ["Code.gs", "index.html"], "reDerive": true,
      "patterns": ["latest_not_running", "epZero", "DEFS.notRunningByPurity", "DEFS.notRunningByHours"],
      "affects": ["eu.kpis", "eu.intel"]
    },
    "def.shared_defs": {
      "desc": "DEFS object — single source of truth for status semantics (euFunctional/euNonFunctional/onaFunctional/euStatusColor/euStatusClass/notRunning*). Change a meaning here and every consumer updates.",
      "files": ["index.html"], "reDerive": false,
      "patterns": ["const DEFS", "DEFS.euStatusColor", "DEFS.euStatusClass"],
      "affects": ["eu.kpis", "ona.kpis", "eu.timeline", "eu.purity", "eu.intel", "comp.eufc"]
    },
    "check.invariants": {
      "desc": "runChecks() structural assertions + ?debug=1 overlay (runDebugOverlay_). A guard, not a data feeder — update it when a widget gains a new structural assumption.",
      "files": ["index.html"], "reDerive": false,
      "patterns": ["function runChecks", "runDebugOverlay_"],
      "affects": []
    },
    "def.filters": {
      "desc": "Filter application (district/plant/date) — fp(), msGet(), applyFacFilter_()",
      "files": ["index.html"], "reDerive": false,
      "patterns": ["applyFacFilter_", "function fp(", "msRebuildPlants"],
      "affects": ["ona.kpis","ona.timeline","ona.purity","ona.intel","eu.kpis","eu.timeline","eu.purity","eu.intel","qr.kpis","qr.funnel","qr.table"]
    },

    "calc.plant_uid": {
      "desc": "Canonical per-plant identity on every plant tab: euUID (QR|district|hospital|capacity|manufacturer) + onaUID (district|facNorm|lpm). Frontend keys TL/TL2, the dropdown, filters and drill-downs by it (euPlantByUID_ on EU; TL.history[uid] inline on ONA).",
      "files": ["Code.gs", "index.html"], "reDerive": true,
      "patterns": ["plant_uid", "function euUID", "function onaUID", "euPlantByUID_", "(d.euQR || '')"],
      "feeds": ["tab.eu_all_plants", "tab.eu_monthly", "tab.eu_timeline", "tab.ona_all_plants", "tab.ona_monthly", "tab.ona_timeline"],
      "affects": ["ona.kpis","ona.timeline","ona.purity","ona.intel","eu.kpis","eu.timeline","eu.purity","eu.intel"]
    },
    "calc.complaint_match": {
      "desc": "Complaint→plant matching (DHC + manufacturer + QR tiebreak), Step E",
      "files": ["Code.gs"], "reDerive": true,
      "patterns": ["codesByAssetDHC", "compParsed", "ambiguousCodes"],
      "feeds": ["tab.plants", "tab.eu_cross"]
    },

    "tab.plants": {
      "desc": "plants tab / RAW.slim_plants (matched ~448 plants, complaints JSON)",
      "files": ["Code.gs", "index.html"], "reDerive": true,
      "patterns": ["plantRows", "RAW.slim_plants", "'plants'"],
      "affects": ["comp.ona.kpis", "comp.fc", "qr.kpis", "qr.funnel", "qr.table", "datareport"]
    },
    "tab.eu_all_plants": {
